\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Baseline Simulation Results ($N=1,000$).} \textbf  {(A)} The Space Elevator shows superior cost stability. \textbf  {(B)} Rocket failures cause non-linear grounding delays. \textbf  {(C)} Under baseline parameters, the utility $J$ improves monotonically as Space Elevator usage increases, indicating $\alpha =1$ is the dominant strategy.}}{14}{figure.caption.7}\protected@file@percent }
\newlabel{fig:risk_analysis}{{4}{14}{\textbf {Baseline Simulation Results ($N=1,000$).} \textbf {(A)} The Space Elevator shows superior cost stability. \textbf {(B)} Rocket failures cause non-linear grounding delays. \textbf {(C)} Under baseline parameters, the utility $J$ improves monotonically as Space Elevator usage increases, indicating $\alpha =1$ is the dominant strategy}{figure.caption.7}{}}

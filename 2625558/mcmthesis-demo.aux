\@writefile{toc}{\contentsline {subsubsection}{\numberline {8.5.1}The "Green Shift" and Capacity Saturation}{22}{subsubsection.8.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Optimal Allocation Strategy under Parallel Execution Constraints.} The green curve depicts the optimal Space Elevator fraction ($\alpha ^*$) rising with increasing environmental priority. The curve demonstrates a \textit  {"Green Shift"} at the tipping point but plateaus due to the \textit  {Capacity Saturation} of the elevator network. This indicates that while the Space Elevator is ecologically necessary, a hybrid strategy remains operationally essential to meet project deadlines.}}{23}{figure.caption.17}\protected@file@percent }
\newlabel{fig:env_optimization}{{8}{23}{\textbf {Optimal Allocation Strategy under Parallel Execution Constraints.} The green curve depicts the optimal Space Elevator fraction ($\alpha ^*$) rising with increasing environmental priority. The curve demonstrates a \textit {"Green Shift"} at the tipping point but plateaus due to the \textit {Capacity Saturation} of the elevator network. This indicates that while the Space Elevator is ecologically necessary, a hybrid strategy remains operationally essential to meet project deadlines}{figure.caption.17}{}}
